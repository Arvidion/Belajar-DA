<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PipelineCuaca</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Host: konfigurasi, dependency injection, dan logging -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.*" />
    <!-- AddHttpClient (HttpClient yang dikelola dengan benar) -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.*" />
    <!-- Database SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Using global agar file kode tidak perlu mengulang namespace ini -->
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="contoh\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
